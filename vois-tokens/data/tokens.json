{
  "description": "Actual design token VALUES for the Vois token set — distinct from data/vois-rules.json, which holds the constraints that govern how tokens are used. Sourced from vois-tokens/references/*.md.",
  "spacing_scale": {
    "source_file": "vois-tokens/references/spacing.md",
    "rule_id": "DS-SPACING-001",
    "unit": "px",
    "description": "All spacing must be divisible by 4 or 8. No exceptions.",
    "allowed_values": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96]
  },
  "type_scale": {
    "source_file": "vois-tokens/references/typography.md",
    "levels": [
      { "level": "Page Heading", "class": "H0", "size": "52px desktop / 40px mobile", "line_height": "64px / 56px", "weight": "bold", "use": "Page title. Once per screen only." },
      { "level": "Section Heading", "class": "H1", "size": "36px desktop / 32px mobile", "line_height": "44px / 40px", "weight": "semibold", "use": "Page sections" },
      { "level": "Feature Heading", "class": "H2", "size": "24px", "line_height": "32px", "weight": "semibold", "use": "Named items, modal titles, core actions" },
      { "level": "Item Heading", "class": "H3", "size": "18px", "line_height": "26px", "weight": "semibold", "use": "Key data points, navigation labels" },
      { "level": "Body Heading", "class": "H4", "size": "16px", "line_height": "24px", "weight": "semibold", "use": "Highlighted inline text, button labels" },
      { "level": "Label Heading", "class": "H5", "size": "14px", "line_height": "20px", "weight": "medium", "use": "Input labels, short descriptions (max 2 lines)" },
      { "level": "Caption", "class": "H6", "size": "12px", "line_height": "16px", "weight": "medium", "use": "Fine print, secondary metadata" },
      { "level": "Body", "class": "Body", "size": "16px", "line_height": "24px", "weight": "normal", "use": "Long-form content, input field content" },
      { "level": "Description", "class": "Description", "size": "14px", "line_height": "20px", "weight": "normal", "use": "Short descriptions in toasts, alerts, dialogs, popovers" }
    ],
    "font_role_tokens": [
      { "role": "Headings and display", "token": "--font-heading" },
      { "role": "Body and labels", "token": "--font-body" },
      { "role": "Numeric and monospace", "token": "--font-mono" }
    ],
    "note": "Font choice itself is workspace-specific — always reference the token, never a font name directly (DS-TYPOGRAPHY-005)."
  },
  "animation_easing": {
    "source_file": "vois-tokens/references/animation.md",
    "usage_table": [
      { "easing": "ease-out", "when_to_use": "Button clicks, taps, component interactions" },
      { "easing": "ease-in-out", "when_to_use": "Elements that change state while staying on screen (progress bars, toggles)" },
      { "easing": "linear", "when_to_use": "Constant-speed loops only — marquees, spinners, hold-to-delete" },
      { "easing": "ease", "when_to_use": "Subtle ambient animations — toasts, notifications" }
    ],
    "custom_curves": {
      "attribution": "Benjamin De Cock, used in Linear",
      "tokens": {
        "--ease-out-quart": "cubic-bezier(.165, .84, .44, 1)",
        "--ease-out-quint": "cubic-bezier(.23, 1, .32, 1)",
        "--ease-out-expo": "cubic-bezier(.19, 1, .22, 1)",
        "--ease-in-out-quart": "cubic-bezier(.77, 0, .175, 1)",
        "--ease-in-out-quint": "cubic-bezier(.86, 0, .07, 1)",
        "--ease-in-out-expo": "cubic-bezier(1, 0, 0, 1)"
      }
    },
    "durations": {
      "ui_animation_default_max": "300ms",
      "large_element_max": "500ms (drawers, action sheets, modals entering)",
      "button_press_transition": "150ms",
      "icon_state_swap_spring": "{ type: \"spring\", duration: 0.3, bounce: 0 }"
    }
  },
  "elevation_tiers": {
    "source_file": "vois-tokens/references/elevation.md",
    "description": "Four tiers — don't invent a fifth.",
    "tiers": [
      { "tier": "Flat", "token": "--shadow-flat", "shadow": "none", "layer": "Inline content, cards at rest, table rows" },
      { "tier": "Raised", "token": "--shadow-raised", "shadow": "0 1px 2px oklch(0 0 0 / 0.08)", "layer": "Hovered cards, buttons, dropdown triggers" },
      { "tier": "Overlay", "token": "--shadow-overlay", "shadow": "0 4px 12px oklch(0 0 0 / 0.12)", "layer": "Popovers, tooltips, dropdown menus" },
      { "tier": "Modal", "token": "--shadow-modal", "shadow": "0 16px 48px oklch(0 0 0 / 0.20)", "layer": "Dialogs, drawers, sheets" }
    ],
    "modal_scrim": "oklch(0 0 0 / 0.4)"
  },
  "surface_border_shadow": {
    "source_file": "vois-tokens/references/surfaces.md",
    "description": "Three-layer shadow acting as a 1px border + lift + ambient depth, used in place of solid borders on cards/containers that show depth.",
    "light_mode": {
      "--shadow-border": "0px 0px 0px 1px rgba(0, 0, 0, 0.06), 0px 1px 2px -1px rgba(0, 0, 0, 0.06), 0px 2px 4px 0px rgba(0, 0, 0, 0.04)",
      "--shadow-border-hover": "0px 0px 0px 1px rgba(0, 0, 0, 0.08), 0px 1px 2px -1px rgba(0, 0, 0, 0.08), 0px 2px 4px 0px rgba(0, 0, 0, 0.06)"
    },
    "dark_mode": {
      "--shadow-border": "0 0 0 1px rgba(255, 255, 255, 0.08)",
      "--shadow-border-hover": "0 0 0 1px rgba(255, 255, 255, 0.13)"
    },
    "image_outline": {
      "light_mode": "rgba(0, 0, 0, 0.1)",
      "dark_mode": "rgba(255, 255, 255, 0.1)"
    }
  },
  "icon_sizes": {
    "source_file": "vois-tokens/references/iconography.md",
    "sizes": [
      { "size_px": 16, "tailwind_class": "size-4", "use": "Inline with body/label text, inside inputs" },
      { "size_px": 20, "tailwind_class": "size-5", "use": "Inline with H4/H5 text, default button icon" },
      { "size_px": 24, "tailwind_class": "size-6", "use": "Standalone icon buttons, nav items" },
      { "size_px": 32, "tailwind_class": "size-8", "use": "Empty states, feature callouts, large standalone icons" }
    ],
    "stroke_width": "1.5px"
  },
  "color": {
    "source_file": "vois-tokens/references/color.md",
    "format": "OKLCH",
    "distribution_rule": "60% neutral / 30% complementary-secondary / 10% accent-brand (DS-COLOR-004)",
    "example_tokens": {
      "--color-primary": "oklch(0.637 0.237 259.4)",
      "--color-primary-foreground": "oklch(1 0 0)"
    },
    "note": "Full workspace color scale is defined per-project via @theme; these are illustrative examples from the reference doc, not the complete palette."
  },
  "breakpoints": {
    "source_file": "vois-tokens/references/css-architecture.md",
    "unit": "em",
    "rule_id": "DS-CSS-007",
    "note": "Use em for hand-authored @media queries, not px, so breakpoints respect the user's browser font-size preference. Tailwind's built-in breakpoints use px internally and are unaffected.",
    "values": [
      { "name": "sm", "em": "40em", "px_equivalent": "640px" },
      { "name": "md", "em": "48em", "px_equivalent": "768px" },
      { "name": "lg", "em": "64em", "px_equivalent": "1024px" },
      { "name": "xl", "em": "80em", "px_equivalent": "1280px" }
    ]
  },
  "contrast_minimums": {
    "source_file": "vois-tokens/references/accessibility.md",
    "rule_id": "DS-A11Y-004",
    "values": [
      { "text_type": "Normal text (under 18px regular, under 14px bold)", "minimum_ratio": "4.5:1" },
      { "text_type": "Large text (18px+ regular, 14px+ bold)", "minimum_ratio": "3:1" },
      { "text_type": "UI components and graphical objects", "minimum_ratio": "3:1" }
    ]
  },
  "touch_target_minimum": {
    "source_file": "vois-tokens/references/accessibility.md",
    "rule_id": "DS-A11Y-001",
    "value": "44x44px"
  }
}
