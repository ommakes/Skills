{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vois-components/data/behavior-card.schema.json",
  "title": "Vois component behavior card",
  "description": "The contract for vois-components/behaviors/<id>.json. One card per component. A card that misses a property, or carries one that is not listed here, fails scripts/behaviors.mjs. The checker reads this file, so the schema and the check cannot drift.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "purpose", "notFor", "basis", "anatomy", "behaviors", "mistakes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "purpose": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "notFor": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["use", "when"],
        "properties": { "use": { "type": "string", "minLength": 1, "pattern": "\\S" }, "when": { "type": "string", "minLength": 1, "pattern": "\\S" } }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library", "checkedAt", "source", "note"],
      "properties": {
        "library": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "note": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "anatomy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part", "required", "note"],
        "properties": { "part": { "type": "string", "minLength": 1, "pattern": "\\S" }, "required": { "type": "boolean" }, "note": { "type": "string", "minLength": 1, "pattern": "\\S" } }
      }
    },
    "behaviors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/behavior" } },
    "mistakes": { "type": "array", "items": { "$ref": "#/$defs/behavior" } }
  },
  "$defs": {
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "group", "text", "support", "rules"],
      "properties": {
        "id": { "type": "string", "pattern": "^BHV-[A-Z][A-Z0-9-]*-\\d{3}$" },
        "group": { "enum": ["interaction", "keyboard", "focus", "state", "accessibility", "mistake"] },
        "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "support": { "enum": ["native", "differs", "supply", "decide", "unchecked"] },
        "evidence": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "note": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "rules": { "type": "array", "items": { "type": "string", "pattern": "^DS-[A-Z0-9]+(-[A-Z0-9]+)*$" } }
      }
    }
  }
}
