{
  "name": "vois-registry",
  "version": "0.32.2",
  "private": true,
  "description": "shadcn-style registry of Vois core components. Build output goes to public/r and is not committed.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "check": "node scripts/check-registry.mjs",
    "test": "node scripts/check-registry.test.mjs",
    "syntax": "node scripts/check-syntax.mjs",
    "syntax:test": "node scripts/check-syntax.test.mjs",
    "panel:test": "node scripts/panel-logic.test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:test": "node scripts/typecheck.test.mjs",
    "icon-button:test": "node scripts/icon-button.test.mjs",
    "menubar:test": "node scripts/menubar.test.mjs",
    "input-otp:test": "node scripts/input-otp.test.mjs",
    "drawer:test": "node scripts/drawer.test.mjs",
    "carousel:test": "node scripts/carousel.test.mjs",
    "resizable:test": "node scripts/resizable.test.mjs",
    "build": "shadcn build registry.json -o public/r",
    "harness": "node harness/build.mjs && node harness/serve.mjs",
    "harness:test": "node scripts/check-harness.test.mjs",
    "harness:check": "node scripts/check-harness.mjs"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tailwindcss/cli": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "esbuild": "0.24.0",
    "input-otp": "1.5.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.2",
    "shadcn": "4.23.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vaul": "1.1.2"
  }
}
