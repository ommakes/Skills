      "id": "phonetic-fluency",
      "name": "Phonetic Fluency (Ease of Mouth)",
      "description": "The brain and mouth prefer sounds that move smoothly from one articulation point to the next.",
      "guidance": [
        {
          "pattern": "Consonant-vowel alternation (CVCV)",
          "effect": "natural rhythm, easy to say",
          "examples": ["Coca-Cola", "TikTok", "Luna", "Milo"]
        },
        {
          "pattern": "Avoid tongue twisters",
          "effect": "words requiring back-and-forth mouth gymnastics feel clunky and hard to process",
          "examples": ["sixth", "rural"]
        }
      ]
    },
    {
      "id": "euphony",
      "name": "Euphony (Sound Harmony)",
      "description": "Some sound combinations are inherently pleasant because they're smooth, sonorous, or balanced.",
      "guidance": [
        {
          "pattern": "Liquids and nasals (l, m, n, r, w, y)",
          "effect": "feel gentle and calm",
          "examples": ["melody", "lullaby", "dream"]
        },
        {
          "pattern": "Plosives (p, b, t, d, k, g)",
          "effect": "add bounce or punch",
          "examples": ["Pop-Tarts", "KitKat", "Get started"]
        },
        {
          "pattern": "Sibilants (s, sh, z)",
          "effect": "add softness or sensuality",
          "examples": ["silky", "shimmer", "serene"]
        }
      ],
      "note": "Mix sound types for contrast and rhythm. Going soft → hard creates balance."
    },
    {
      "id": "prosody-and-rhythm",
      "name": "Prosody and Rhythm",
      "description": "Humans unconsciously crave meter and stress balance.",
      "guidance": [
        {
          "pattern": "Two beats",
          "effect": "catchy and punchy",
          "examples": ["Snapchat", "Netflix", "Submit", "Sign up"]
        },
        {
          "pattern": "Three beats",
          "effect": "melodic and memorable",
          "examples": ["Mickey Mouse", "Coca-Cola", "Get started"]
        },
        {
          "pattern": "Irregular stress",
          "effect": "awkward and forgettable",
          "examples": ["ParsnipCloud", "UploadNow"]
        },
        {
          "pattern": "Trochaic rhythm (stress-unstress)",
          "effect": "hits hard then glides",
          "examples": ["Apple", "Google", "Spotify"]
        }
      ]
    },
    {
